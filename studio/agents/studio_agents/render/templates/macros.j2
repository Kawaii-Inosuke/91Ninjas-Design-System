{# Item markers. size = marker box in px; icons scale with it (brand icon.scale). #}
{% macro marker(kind, n, item, size) %}
{% if kind == "icon" and item.icon %}<span class="marker icon" data-layer="marker" style="width:{{ size }}px;height:{{ size }}px">{{ icon(item.icon, size) }}</span>
{% elif kind == "check" %}<span class="marker check" data-layer="marker">{{ icon("circle-check", size) }}</span>
{% else %}<span class="marker number" data-layer="marker" style="width:{{ size }}px;height:{{ size }}px">{{ "%02d" | format(n) }}</span>
{% endif %}
{% endmacro %}
{% macro text(it) %}{% if it.heading %}<p class="h" data-layer="heading">{{ it.heading }}</p>{% endif %}{% if it.body %}<p class="b" data-layer="body">{{ it.body }}</p>{% endif %}{% endmacro %}
