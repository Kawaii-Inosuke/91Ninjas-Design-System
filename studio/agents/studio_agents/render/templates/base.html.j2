<!doctype html>
<html><head><meta charset="utf-8">
<style>
{{ font_faces }}
{{ css_vars }}
{{ base_css }}
body, #canvas { width: {{ width }}px; }
{% if height %}#canvas { height: {{ height }}px; }{% endif %}
{{ brand_css }}
{{ spec_css }}
</style></head>
<body><div id="canvas" data-layer="canvas">
  <header class="title-bar" data-layer="title">{{ spec.title }}</header>
  <main class="content layout-{{ family }}" data-layer="content">
    {% if spec.subtitle %}<p class="subtitle b" data-layer="subtitle">{{ spec.subtitle }}</p>{% endif %}
    {% block body %}{% endblock %}
    {% if spec.takeaway %}<div class="takeaway b" data-layer="takeaway">{{ spec.takeaway }}</div>{% endif %}
  </main>
</div></body></html>
