<?xml version="1.0" encoding="utf-8"?>
<!-- 91Ninjas Studio for Windows (D-040): a per-user MSI (no admin rights, so in-app updates need none either)
     with a Start menu entry and a desktop shortcut (a ticked box in the wizard). It installs the editor, the
     bundled `uv` and the agents (the connector Claude uses and the panel's local service). Built by
     package.ps1; the UpgradeCode never changes, so each version replaces the one before. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="91Ninjas Studio" Manufacturer="91Ninjas" Version="$(var.Version)" UpgradeCode="86AE92D7-99D4-4624-91D7-F9EF1E85E9C9"
           Scope="perUser" Compressed="yes" Language="1033">
    <SummaryInformation Description="91Ninjas Studio: on-brand design with Claude" Manufacturer="91Ninjas" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of 91Ninjas Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="StudioIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="StudioIcon.ico" />

    <!-- %LOCALAPPDATA%\Programs\91Ninjas Studio: the user's own programs folder (no admin rights). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="91Ninjas Studio">
          <Directory Id="AgentsFolder" Name="agents" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="91Ninjas Studio" Level="1">
      <ComponentGroupRef Id="StudioFiles" />
      <ComponentGroupRef Id="AgentsFiles" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="91Ninjas Studio Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Where 91Ninjas Studio can be started from." />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut" />
        <Control Id="StartMenuNote" Type="Text" X="20" Y="84" Width="330" Height="30" NoPrefix="yes" Text="91Ninjas Studio is also added to the Start menu." />
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchStudio" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="91Ninjas Studio $(var.DisplayVersion) is installed. The first start takes a few minutes while it gets its AI tools ready." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start 91Ninjas Studio" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#StudioExe]" />
    <CustomAction Id="LaunchStudio" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="StudioFiles" Directory="INSTALLFOLDER">
      <Component Id="StudioApp" Guid="30E2ECA0-8562-4347-9C96-D47CBFA2284D">
        <File Id="StudioExe" Source="$(var.StageDir)\vectorcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="91Ninjas Studio" Description="On-brand design with Claude"
                    WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="StudioIcon.ico" IconIndex="0" />
        </File>
        <!-- Where the updater (craft-update) finds this install: SOFTWARE\<app name>\InstallDir. -->
        <RegistryValue Root="HKMU" Key="Software\91Ninjas Studio" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>
      <Component Id="Uv">
        <File Id="UvExe" Source="$(var.StageDir)\uv.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="AgentsFiles" Directory="AgentsFolder">
      <Files Include="$(var.StageDir)\agents\**" />
    </ComponentGroup>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="4C219E55-79BB-4F80-B29D-55E5DDE00463" Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut" Name="91Ninjas Studio" Description="On-brand design with Claude" Target="[#StudioExe]"
                WorkingDirectory="INSTALLFOLDER" Icon="StudioIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKMU" Key="Software\91Ninjas Studio" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
